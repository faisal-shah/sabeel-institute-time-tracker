rules_version = '2';

// Deny-by-default. The backend (Cloud Functions, admin SDK) bypasses all rules;
// clients get only the narrow, explicitly-allowed paths below.
//
// Roles live in custom claims (`role`, `status`, `admin`), set exclusively by the
// setUserAccess callable. The user doc mirrors them for UI display; the token is
// what rules trust.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isActive() {
      return isSignedIn() && request.auth.token.get('status', '') == 'active';
    }
    function isManager() {
      return isActive() && request.auth.token.get('role', '') == 'manager';
    }
    // Only admins approve users / change roles; they need to read profiles
    // (name, email) to do it, even if they aren't managers themselves.
    function isAdmin() {
      return isActive() && request.auth.token.get('admin', false) == true;
    }

    match /users/{uid} {
      // Self-registration: a new sign-in creates its own profile, forced pending
      // with no privileges. role/status/admin changes only via setUserAccess.
      allow create: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.status == 'pending'
        && request.resource.data.role == 'member'
        && request.resource.data.admin == false
        && request.resource.data.activeEntryId == null;
      allow read: if isSignedIn() && (request.auth.uid == uid || isManager() || isAdmin());
      // Self may only touch the clock pointer and cosmetic profile fields.
      allow update: if isActive() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['activeEntryId', 'displayName', 'photoURL']);
      allow delete: if false;
    }

    // Projects/programs/events hours are assigned to. Any active user picks from
    // them; only managers shape the list. Never deleted — archived (status flip),
    // so historical entries keep a valid reference.
    match /activities/{activityId} {
      allow read: if isActive();
      allow create: if isManager()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.type in ['project', 'event']
        && request.resource.data.status in ['active', 'archived'];
      allow update: if isManager()
        && request.resource.data.type in ['project', 'event']
        && request.resource.data.status in ['active', 'archived'];
      allow delete: if false;
    }
  }
}
